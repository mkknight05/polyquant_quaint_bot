APP_ENV=local
PAPER_MODE=true

KALSHI_BASE_URL=https://api.elections.kalshi.com
KALSHI_API_KEY=REPLACE_ME
KALSHI_API_SECRET=REPLACE_ME
KALSHI_KEY_ID=REPLACE_ME
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

POLYGON_RPC_URL=https://your-primary-rpc
POLYGON_RPC_URL_BACKUP=https://your-backup-rpc

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME

# MVP runtime knobs
SQLITE_PATH=data/mvp.db
SYMBOL=BTC-USD
TRADE_QTY=0.01
SPREAD_THRESHOLD=0.01
STARTING_CASH=10000

# Polymarket CLOB config
POLYMARKET_USE_SYNTHETIC=true
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_TOKEN_ID=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Service-mode handoff/state files
SIGNAL_QUEUE_PATH=data/signals.jsonl
BROKER_STATE_PATH=data/broker_state.json
