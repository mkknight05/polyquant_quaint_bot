# ---- Runtime mode ----
# check  = connectivity tests only (safe)
# signal = connectivity + read-only strategy signal + optional Telegram notify
# live   = placeholder for live trading phase
BOT_MODE=check

# ---- Exchange/API credentials ----
# Coinbase (Advanced Trade / CDP)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Polymarket CLOB
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# Kalshi
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Gemini
GEMINI_API_KEY=
GEMINI_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Optional endpoints ----
COINBASE_BASE_URL=https://api.coinbase.com
OKX_BASE_URL=https://www.okx.com
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com
KALSHI_BASE_URL=https://api.elections.kalshi.com
GEMINI_BASE_URL=https://api.gemini.com

# network timeout per external API check (seconds)
API_CHECK_TIMEOUT_SECONDS=4

# ---- Signal shadow-mode (read-only) ----
SIGNAL_STRATEGY_NAME=mean_reversion_stub
SIGNAL_DEFAULT_MARKET=POLYMARKET:DEMO
SIGNAL_TELEGRAM_DRY_RUN=true
TELEGRAM_TIMEOUT_SECONDS=5
